<Project Sdk="Microsoft.Build.NoTargets/3.7.134">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Provides targets for projects that result into a data-tier application package (DACPAC).</Description>
    <PackageTags>MSBuild MSBuildSdk sql dacpac</PackageTags>
    <PackageProjectUrl>https://github.com/rr-wfm/MSBuild.Sdk.SqlProj/</PackageProjectUrl>
    <PackageType>MSBuildSdk</PackageType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>docs\README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/rr-wfm/MSBuild.Sdk.SqlProj/</RepositoryUrl>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DacpacTool\DacpacTool.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="TargetFramework;TargetFrameworks" />
    <None Include="Sdk\**\*" Pack="true" PackagePath="Sdk\%(RecursiveDir)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <Target Name="CollectPackageFiles" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="..\..\LICENSE" DestinationFiles="$(IntermediateOutputPath)LICENSE.txt" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)LICENSE.txt" Pack="true" PackagePath="\" />
      <None Include="tools\DacpacTool\**\*" Pack="true" PackagePath="tools\DacpacTool\%(RecursiveDir)" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeDacpacTool" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\DacpacTool\DacpacTool.csproj"
             Targets="Publish"
             RemoveProperties="TargetFramework;TargetFrameworks"
             Properties="Configuration=$(Configuration);PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'tools', 'DacpacTool'))" />
  </Target>

</Project>