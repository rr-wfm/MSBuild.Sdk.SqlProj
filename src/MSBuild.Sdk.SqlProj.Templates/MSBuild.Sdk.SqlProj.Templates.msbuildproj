<Project Sdk="Microsoft.Build.NoTargets/3.7.134">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>MSBuild.Sdk.SqlProj.Templates</PackageId>
    <Title>MSBuild.Sdk.SqlProj templates</Title>
    <Authors>MSBuild.Sdk.SqlProj</Authors>
    <Description>Templates that can be used to scaffold new MSBuild.Sdk.SqlProj projects.</Description>
    <PackageTags>dotnet-new templates MSBuild MSBuildSdk sql dacpac</PackageTags>
    <PackageProjectUrl>https://github.com/rr-wfm/MSBuild.Sdk.SqlProj/</PackageProjectUrl>

    <TargetFramework>netstandard2.0</TargetFramework>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/rr-wfm/MSBuild.Sdk.SqlProj/</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="templates\**\*" Pack="true" PackagePath="content\" />
  </ItemGroup>

  <Target Name="CollectPackageFiles" BeforeTargets="_GetPackageFiles">
    <Copy SourceFiles="..\..\LICENSE" DestinationFiles="$(IntermediateOutputPath)LICENSE.txt" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)LICENSE.txt" Pack="true" PackagePath="\" />
    </ItemGroup>
  </Target>

</Project>